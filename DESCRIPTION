Package: HeatStressR
Type: Package
Title: Calculate Heat Stress Indices
Version: 3.0.0
Date: 2026-10-06
Authors@R: c(
    person("Yifei", "Zheng", email = "zyf0717@gmail.com", role = c("aut", "cre"),
           comment = c(ORCID = "0009-0001-4858-2025",
